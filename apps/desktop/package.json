{
  "name": "@ravel/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "RAVEL thin Electron client: sign-in and a read-only project list.",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "node scripts/build.mjs --libs-only && node --test \"../../tests/premium/T14/node/*.test.cjs\"",
    "test:e2e": "node ../../tests/premium/T14/electron/run-electron.cjs",
    "package:win": "node scripts/build.mjs && electron-builder --win portable --x64 --config electron-builder.yml"
  },
  "devDependencies": {
    "@ravel/api-client": "workspace:*",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.6.3",
    "vite": "8.3.4"
  }
}

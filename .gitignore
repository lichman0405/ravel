# ── Logs / temp ────────────────────────────────────────────────────────────
*.log
logs/
tmp/
.tmp/
.cache/

# ── Working notes that are not published ───────────────────────────────────
# Raw live-run records and seat designs: written for the people doing the work,
# quoted by KNOWN_LIMITATIONS.md and docs/ in substance rather than by citation,
# and deliberately not part of what this repository publishes. They stay on disk;
# they do not enter Git.
PHASE10_LIVE_FINDINGS.md
PHASE10_RESEARCH_SEAT_DESIGN.md

# ── Editors / OS ───────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Vendored upstream DSH checkout ─────────────────────────────────────────
# We pin DSH by tag+commit in vendor/DSH_PIN.json and re-fetch deterministically.
# The upstream source tree itself is NOT committed (never copy DSH internals).
vendor/deepseek-harness/
vendor/*.tgz
vendor/*.whl

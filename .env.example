# RAVEL V0 environment template.
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Every variable below is read by `src/ravel/config.py`. Defaults shown are the
# values used when the variable is absent, and they match docker-compose.yml.

# ─── Runtime ────────────────────────────────────────────────────────────────

RAVEL_ENV=development
RAVEL_LOG_LEVEL=INFO

# `text` for a person reading a terminal, `json` for a collector. The JSON line
# carries `ts`, `level`, `service`, `logger` and `message`, plus whatever the
# call site added — so a query names a field instead of matching a sentence.
# Each of the three services writes its own name into every line, which is what
# makes one journal readable when all three are in it.
RAVEL_LOG_FORMAT=text

# Root for RAVEL-owned runtime state: DSH homes, workspaces, snapshots.
# Created on first use. Must NOT live inside a research workspace.
RAVEL_RUNTIME_DIR=./runtime

# ─── PostgreSQL — authoritative Project State ───────────────────────────────

# Host port 55432 avoids the default 5432, which is commonly already bound.
RAVEL_POSTGRES_HOST=127.0.0.1
RAVEL_POSTGRES_PORT=55432
RAVEL_POSTGRES_DB=ravel
RAVEL_POSTGRES_USER=ravel
RAVEL_POSTGRES_PASSWORD=ravel_dev_password

# Derived from the five values above when unset. Set explicitly to override.
# RAVEL_POSTGRES_DSN=postgresql+psycopg://ravel:ravel_dev_password@127.0.0.1:55432/ravel

# ─── Temporal — durable execution only, never the scientific record ─────────

RAVEL_TEMPORAL_HOST=127.0.0.1:7233
RAVEL_TEMPORAL_NAMESPACE=default
RAVEL_TEMPORAL_TASK_QUEUE=ravel-v0

# ─── Slurm — the real compute backend, off unless asked for ─────────────────
#
# Only read when the worker is started with `--compute-backend slurm`; the
# default deployment runs the compute mock and needs none of this. With no host
# or username set, that flag is refused at start-up rather than at the first
# node that reaches the queue.
#
# These settings are read by the worker process and by nothing else. The
# password below is the one value here that must never reach a model: it is
# listed in the settings' launcher-only prefix set, so it is stripped from the
# environment of every DSH runtime and tool server RAVEL starts, and it is read
# by the SSH transport and by no other code. Leave it empty to authenticate with
# a key instead.
#
# RAVEL_SLURM_HOST=cluster.example.org
# RAVEL_SLURM_USERNAME=ravel
# RAVEL_SLURM_PASSWORD=
# RAVEL_SLURM_KEY_FILENAME=/etc/ravel/id_ed25519
# RAVEL_SLURM_PORT=22
# RAVEL_SLURM_JOBS_ROOT=/ravel/jobs
#
# Off by default, and deliberately so: accepting an unknown host key is what
# makes an SSH client vulnerable to a host that is only pretending to be the
# cluster. Turn it on for a first connection to a new machine, if at all.
# RAVEL_SLURM_TRUST_UNKNOWN_HOST=false

# ─── MinIO / S3-compatible object storage — artifact bytes live here ────────

RAVEL_S3_ENDPOINT=http://127.0.0.1:9100
RAVEL_S3_ACCESS_KEY=ravel_minio
RAVEL_S3_SECRET_KEY=ravel_minio_dev_password
RAVEL_S3_BUCKET=ravel-artifacts
RAVEL_S3_REGION=us-east-1

# ─── DeepSeek Harness (the only harness) ────────────────────────────────────

# Root of the RAVEL-managed DSH home. Profiles, session logs, and the
# credential store live under it.
RAVEL_DSH_HOME=./runtime/dsh_home

# Prefer the wheel-bundled runtime. Point this at a `dsh` binary to override.
RAVEL_DSH_BIN=

# ─── Model credentials ──────────────────────────────────────────────────────
#
# The pinned harness resolves this name per request through its `apiKeyEnv`
# config key. An inherited environment variable wins over every file layer, so
# setting it here is authoritative for RAVEL-launched runtimes.
#
# Required. Get one from https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Optional. Overrides the DeepSeek API endpoint.
# DEEPSEEK_BASE_URL=

# ─── Research Source Gateway ────────────────────────────────────────────────
#
# RAVEL prefers keyless real sources (Crossref, OpenAlex, arXiv, standards
# bodies) and works without any credential below. A search API key is an
# enhancement, never a substitute: RAVEL never falls back to mock search.

# Optional. Polite-pool identification for Crossref/OpenAlex requests.
RAVEL_RESEARCH_CONTACT_EMAIL=

# Optional. Enables an additional commercial web-search provider.
RAVEL_SEARCH_API_KEY=
RAVEL_SEARCH_PROVIDER=

# Browser research. Headless by default; set false to watch a run.
RAVEL_PLAYWRIGHT_HEADLESS=true

# ─── Gateway ────────────────────────────────────────────────────────────────

RAVEL_GATEWAY_HOST=127.0.0.1
RAVEL_GATEWAY_PORT=8000
RAVEL_GATEWAY_JWT_SECRET=dev-only-change-me
RAVEL_GATEWAY_TOKEN_TTL_SECONDS=3600

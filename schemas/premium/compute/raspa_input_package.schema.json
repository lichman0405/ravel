{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ravel.local/schemas/premium/compute/raspa_input_package.schema.json",
  "title": "RAVEL immutable RASPA input package manifest",
  "description": "The manifest written beside a RASPA GCMC input package. Its canonical JSON with package_sha256 removed is the package digest. It fixes required outputs, the result parser schema, convergence and numeric tolerances, and the Review criteria before any run, and contains no timestamp or run result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package_sha256",
    "route",
    "project_id",
    "node_id",
    "node_display_id",
    "objective",
    "execution_contract",
    "materializer",
    "materializer_version",
    "method",
    "scientific_contract",
    "software",
    "required_outputs",
    "output_filename",
    "stop_conditions",
    "inputs",
    "sources",
    "acceptance",
    "parser",
    "convergence",
    "evidence_scope",
    "real_run",
    "generated_files"
  ],
  "properties": {
    "schema": {"const": "ravel.raspa.input_package/1"},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "software",
        "version_series",
        "method",
        "supported_property",
        "supported_output",
        "unsupported_methods",
        "real_run_task",
        "real_run_status",
        "real_run_blocker",
        "real_run_unlock",
        "evidence_scope"
      ],
      "properties": {
        "route_id": {"const": "raspa/gcmc-gas-adsorption"},
        "software": {"const": "RASPA"},
        "version_series": {"const": "2.0"},
        "method": {"const": "GCMC"},
        "supported_property": {"type": "string", "minLength": 1},
        "supported_output": {"type": "string", "minLength": 1},
        "unsupported_methods": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "real_run_task": {"const": "T25"},
        "real_run_status": {"const": "BLOCKED_EXTERNAL"},
        "real_run_blocker": {"type": "string", "minLength": 1},
        "real_run_unlock": {"type": "string", "minLength": 1},
        "evidence_scope": {"type": "string", "minLength": 1}
      }
    },
    "project_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "node_display_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "execution_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_ref", "contract_version"],
      "properties": {
        "contract_ref": {"type": "string", "minLength": 1},
        "contract_version": {"type": "integer", "minimum": 1}
      }
    },
    "materializer": {"const": "raspa-gcmc"},
    "materializer_version": {"type": "string", "minLength": 1},
    "method": {"const": "GCMC"},
    "scientific_contract": {
      "type": "object",
      "required": ["route_id", "software", "execution_contract", "method", "temperature", "pressure", "sampling", "system", "units"],
      "properties": {
        "route_id": {"const": "raspa/gcmc-gas-adsorption"},
        "method": {"const": "GCMC"}
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version_series", "environment"],
      "properties": {
        "name": {"const": "RASPA"},
        "version_series": {"const": "2.0"},
        "environment": {"const": "probe_required"}
      }
    },
    "required_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "output_filename": {"type": "string", "minLength": 1},
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "inputs": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "sha256", "size_bytes", "source_key", "source", "license"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "role": {"const": "INPUT"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "source_key": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "url", "raw_url", "repository", "commit", "tag", "path", "sha256", "license", "license_ref", "citation", "role"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "raw_url": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "minLength": 1},
          "commit": {"type": "string", "minLength": 1},
          "tag": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "license": {"type": "string", "minLength": 1},
          "license_ref": {"type": "string", "minLength": 1},
          "citation": {"type": "string"},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_ref", "contract_version", "criteria", "criteria_sha256"],
      "properties": {
        "contract_ref": {"type": "string", "minLength": 1},
        "contract_version": {"type": "integer", "minimum": 1},
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion_id", "statement", "metric", "threshold", "provenance", "provenance_ref", "notes"],
            "properties": {
              "criterion_id": {"type": "string", "minLength": 1},
              "statement": {"type": "string", "minLength": 1},
              "metric": {"type": "string"},
              "threshold": {"type": "string"},
              "provenance": {"type": "string", "minLength": 1},
              "provenance_ref": {"type": ["string", "null"]},
              "notes": {"type": "string"}
            }
          }
        },
        "criteria_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "schema_sha256", "result_statuses", "evidence_classes"],
      "properties": {
        "schema_id": {"const": "https://ravel.local/schemas/premium/compute/raspa_result.schema.json"},
        "schema_version": {"const": "1"},
        "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "result_statuses": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"enum": ["NORMAL", "NON_CONVERGED", "SOFTWARE_FAILURE"]}
        },
        "evidence_classes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"enum": ["COMPUTATION", "SIMULATED"]}
        }
      }
    },
    "convergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "min_blocks", "max_relative_standard_error", "numeric_relative_tolerance", "provenance", "provenance_ref", "fixed_before_run"],
      "properties": {
        "policy_version": {"type": "string", "minLength": 1},
        "min_blocks": {"type": "integer", "minimum": 1},
        "max_relative_standard_error": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "numeric_relative_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "provenance": {"const": "PROVISIONAL"},
        "provenance_ref": {"type": "string", "minLength": 1},
        "fixed_before_run": {"const": true}
      }
    },
    "evidence_scope": {"const": "IMPLEMENTATION_ONLY"},
    "real_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "status", "blocker", "unlock"],
      "properties": {
        "task": {"const": "T25"},
        "status": {"const": "BLOCKED_EXTERNAL"},
        "blocker": {"type": "string", "minLength": 1},
        "unlock": {"type": "string", "minLength": 1}
      }
    },
    "generated_files": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "sha256", "size_bytes"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "role": {"enum": ["INPUT", "MANIFEST"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}

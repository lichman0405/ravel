{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ravel.local/schemas/premium/hpc_target.schema.json",
  "title": "HpcTarget",
  "description": "An operator-provisioned Slurm-over-SSH target. Credentials and known_hosts are references resolved only in the execution process; they never enter model tool arguments.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_id",
    "kind",
    "host",
    "port",
    "username",
    "known_hosts_ref",
    "credential_ref",
    "remote_root",
    "allowed_software",
    "max_jobs",
    "enabled"
  ],
  "properties": {
    "target_id": {"type": "string", "format": "uuid"},
    "kind": {"type": "string", "const": "SLURM_SSH"},
    "host": {"type": "string", "minLength": 1, "maxLength": 253},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "username": {"type": "string", "minLength": 1, "maxLength": 128},
    "known_hosts_ref": {"type": "string", "minLength": 1},
    "credential_ref": {"type": "string", "minLength": 1},
    "partition": {"type": ["string", "null"], "maxLength": 64},
    "account": {"type": ["string", "null"], "maxLength": 128},
    "remote_root": {"type": "string", "minLength": 1, "maxLength": 1024},
    "allowed_software": {
      "type": "array",
      "items": {"type": "string", "maxLength": 64}
    },
    "max_jobs": {"type": "integer", "minimum": 1},
    "cpu_limit": {"type": ["integer", "null"], "minimum": 1},
    "gpu_limit": {"type": ["integer", "null"], "minimum": 0},
    "hour_limit": {"type": ["number", "null"], "minimum": 0},
    "enabled": {"type": "boolean"}
  }
}
